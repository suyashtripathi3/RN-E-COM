{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.suyash.rnecom"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "name": "RN-E-COM",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "scheme": "rnecom",
    "slug": "rn-e-com",
    "userInterfaceStyle": "light",
    "version": "0.1.0",
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}